# gitignore
HEAD
.cache
v*
alias

# For testing
test/bak
.urchin.log
.urchin_stdout
test/**/test_output
test/**/.nvmrc

node_modules/
npm-debug.log

.DS_Store
current
._*
output/
!auto-switch/vendor/
!auto-switch/vendor/**
!auto-switch/verify-vendor.py
/default-packages

# Only apps should have lockfiles
npm-shrinkwrap.json
package-lock.json
yarn.lock

target/
desktop/dist/
!desktop/vite.config.mjs
!desktop/src/Views.jsx
.playwright-cli/

# Native macOS sources, including Version/Views files excluded by upstream v*.
!macos/
!macos/**
macos/**/xcuserdata/
macos/**/.DS_Store
macos/**/._*

# Local design sessions and planning notes are not distribution source.
/design/
/prompt/
/design-qa.md
/macos/checklist-release.json

# Local credentials and signing material (keep these after source exceptions).
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
*.p12
*.pfx
*.mobileprovision
