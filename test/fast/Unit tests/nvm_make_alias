#!/bin/sh

die () { echo "$@" ; exit 1; }

\. ../../../nvm.sh

OUTPUT="$(nvm_make_alias 2>&1)"
EXIT_CODE="$(nvm_make_alias >/dev/null 2>&1 ; echo $?)"
EXPECTED_OUTPUT='an alias name is required'

[ "_$OUTPUT" = "_$EXPECTED_OUTPUT" ] || die "\`nvm_make_alias\` did not error with '$EXPECTED_OUTPUT'; got '$OUTPUT'"
[ "$EXIT_CODE" -eq 1 ] || die "\`nvm_make_alias\` did not exit with 1, got '$EXIT_CODE'"

OUTPUT="$(nvm_make_alias foo 2>&1)"
EXIT_CODE="$(nvm_make_alias foo >/dev/null 2>&1 ; echo $?)"
EXPECTED_OUTPUT='an alias target version is required'

[ "_$OUTPUT" = "_$EXPECTED_OUTPUT" ] || die "\`nvm_make_alias foo\` did not error with '$EXPECTED_OUTPUT'; got '$OUTPUT'"
[ "$EXIT_CODE" -eq 2 ] || die "\`nvm_make_alias foo\` did not exit with 2, got '$EXIT_CODE'"

for INVALID in ../outside lts/../../outside lts/.. . .. /absolute 'nested/name' 'lts/name/child'; do
  if nvm_make_alias "${INVALID}" v22.0.0 >/dev/null 2>&1; then
    die "unsafe alias accepted: ${INVALID}"
  fi
done

TEST_DIR="$(mktemp -d)" || die 'unable to create test directory'
cleanup() { command rm -rf "${TEST_DIR}"; }
trap cleanup EXIT
NVM_DIR="${TEST_DIR}/nvm"
nvm_make_alias default v22.0.0 || die 'default alias rejected'
nvm_make_alias team_node-v22 v22.0.0 || die 'normal custom alias rejected'
nvm_make_alias lts/testing v22.0.0 || die 'normal LTS alias rejected'
nvm_make_alias 'lts/*' lts/testing || die 'LTS wildcard alias rejected'
[ "$(cat "${NVM_DIR}/alias/default")" = v22.0.0 ] || die 'alias contents were changed'

command printf '%s\n' unchanged > "${TEST_DIR}/outside"
command ln -s "${TEST_DIR}/outside" "${NVM_DIR}/alias/linked"
if nvm_make_alias linked v22.0.0 >/dev/null 2>&1; then die 'symlink alias accepted'; fi
[ "$(cat "${TEST_DIR}/outside")" = unchanged ] || die 'symlink destination was modified'

command mv "${NVM_DIR}/alias/lts" "${TEST_DIR}/outside-lts"
command ln -s "${TEST_DIR}/outside-lts" "${NVM_DIR}/alias/lts"
if nvm_make_alias lts/testing v24.0.0 >/dev/null 2>&1; then die 'symlink LTS directory accepted'; fi
[ "$(cat "${TEST_DIR}/outside-lts/testing")" = v22.0.0 ] || die 'external LTS alias was modified'

command mv "${NVM_DIR}/alias" "${TEST_DIR}/outside-alias"
command ln -s "${TEST_DIR}/outside-alias" "${NVM_DIR}/alias"
if nvm_make_alias default v24.0.0 >/dev/null 2>&1; then die 'symlink alias directory accepted'; fi
[ "$(cat "${TEST_DIR}/outside-alias/default")" = v22.0.0 ] || die 'external default alias was modified'
